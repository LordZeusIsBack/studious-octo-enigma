# Local: copy this file to .env and fill it in. On Railway: add these in the service's Variables tab instead.

# Password for /admin (the username is always "admin"). Use something long.
ADMIN_PASSWORD=change-me

# From resend.com > API Keys. Without it, bookings still save but the email shows as failed in /admin.
RESEND_API_KEY=

# Who receives booking emails. Defaults to the host email in shared/event.ts.
# Without a verified domain, Resend only delivers to the address that owns the Resend account.
# EMAIL_TO=harshitgiis@gmail.com

# Railway only: the volume is mounted at /data. Locally this defaults to ./data/gamenight.db.
# DATABASE_PATH=/data/gamenight.db

# Only after you verify your own domain in Resend. Until then the default test sender is used.
# EMAIL_FROM=Game Night <bookings@your-domain.com>
